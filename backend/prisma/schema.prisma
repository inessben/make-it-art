generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  EUR
}

enum ArtworkSaleStatus {
  DRAFT
  AVAILABLE
  SOLD_OUT
  UNLISTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAYMENT_FAILED
  PAYMENT_REVIEW
  PAID
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum FulfillmentTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id                      Int                      @id @default(autoincrement())
  username                String?
  email                   String?                  @unique
  passwordHash            String?                  @map("password_hash")
  oauthProvider           String?                  @map("oauth_provider")
  oauthSubject            String?                  @map("oauth_subject")
  oauthLinkedAt           DateTime?                @map("oauth_linked_at")
  role                    String?
  createdAt               DateTime?                @map("created_at")
  bio                     String?
  isActive                Boolean?                 @map("is_active")
  walletAddress           String?                  @map("wallet_addresse")
  verified                Boolean?
  phone                   String?
  admin                   Admin?
  artistApplicationDraft  ArtistApplicationDraft?
  artist                  Artist?
  moderatedArtworks       Artwork[]                @relation("artwork_moderated_by")
  reviewedArtistApplications ArtistApplicationDraft[] @relation("artist_application_reviewed_by")
  auditLogs               AuditLog[]
  consents                ConsentRGPD[]
  emailVerificationTokens EmailVerificationToken[] @relation("emailVerificationTokens")
  favorites               Favorite[]
  follows                 Follow[]
  loginVerificationCodes  LoginVerificationCode[]  @relation("loginVerificationCodes")
  orders                  Order[]
  ownershipTokens         OwnershipToken[]
  passwordResetTokens     PasswordResetToken[]     @relation("passwordResetTokens")
  personalCollections     Collection[]             @relation("user_collections")
  refreshTokens           RefreshToken[]
  rememberedDevices       RememberedDevice[]       @relation("rememberedDevices")
  galleries               UserGallery[]
  cart                    Cart?
  refundsRequested        Refund[]                 @relation("refundRequestedBy")

  @@unique([oauthProvider, oauthSubject])
  @@map("user")
}

model ArtistApplicationDraft {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  currentStep        Int       @default(1) @map("current_step")
  status             String    @default("draft")
  payload            Json?
  completedAt        DateTime? @map("completed_at")
  submittedAt        DateTime? @map("submitted_at")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewedByAdminId  Int?      @map("reviewed_by_admin_id")
  reviewNote         String?   @map("review_note")
  contractAcceptedAt DateTime? @map("contract_accepted_at")
  contractSignedAt   DateTime? @map("contract_signed_at")
  contractVersion    String?   @map("contract_version")
  signatureDataUrl   String?   @map("signature_data_url")
  contractPdf        Bytes?    @map("contract_pdf")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id])
  reviewedByAdmin    User?     @relation("artist_application_reviewed_by", fields: [reviewedByAdminId], references: [id])

  @@map("artist_application_draft")
}

model Artist {
  id          Int          @id @default(autoincrement())
  userId      Int          @unique @map("user_id")
  displayName String?      @map("display_name")
  verified    Boolean?
  createdAt   DateTime?    @map("created_at")
  user        User         @relation(fields: [userId], references: [id])
  artworks    Artwork[]
  collections Collection[]
  followers   Follow[]

  @@map("artist")
}

model Admin {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique @map("user_id")
  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  user         User    @relation(fields: [userId], references: [id])

  @@map("admin")
}

model Artwork {
  id               Int                    @id @default(autoincrement())
  artistId         Int                    @map("artist_id")
  title            String?
  description      String?
  categoryId       Int?                   @map("category_id")
  // Temporary read compatibility for develop. Stripe checkout never reads
  // these free-form legacy values; priceAmount is the only payable amount.
  priceTokens      String?                 @map("price_tokens")
  price            String?
  priceAmount      Int?                   @map("price_amount")
  currency         Currency               @default(EUR)
  favoriteCount    Int?                   @map("favorite_count")
  createdAt        DateTime?              @map("created_at")
  protection       Boolean?
  protectionId     Int?                   @map("protection_id")
  artist           Artist                 @relation(fields: [artistId], references: [id])
  category         Category?              @relation(fields: [categoryId], references: [id])
  collections      CollectionItem[]
  favorites        Favorite[]
  moderationStatus String                  @default("approved") @map("moderation_status")
  moderationNote   String?                 @map("moderation_note")
  moderatedAt      DateTime?               @map("moderated_at")
  moderatedByAdminId Int?                  @map("moderated_by_admin_id")
  moderatedByAdmin User?                   @relation("artwork_moderated_by", fields: [moderatedByAdminId], references: [id])
  orderItems       OrderItem[]
  ownershipTokens  OwnershipToken[]
  galleries        UserGallery[]
  cartItems        CartItem[]
  reservations     InventoryReservation[]
  saleStatus       ArtworkSaleStatus      @default(DRAFT) @map("sale_status")
  stockQuantity    Int                    @default(0) @map("stock_quantity")
  reservedQuantity Int                    @default(0) @map("reserved_quantity")

  @@map("artwork")
}

model OwnershipToken {
  id              Int           @id @default(autoincrement())
  artworkId       Int           @map("artwork_id")
  ownerId         Int           @map("owner_id")
  tokenId         Int?          @map("token_id")
  acquiredAt      DateTime?     @map("acquired_at")
  transactionHash String?       @map("transaction_hash")
  isCurrentOwner  Boolean?      @map("is_current_owner")
  artwork         Artwork       @relation(fields: [artworkId], references: [id])
  owner           User          @relation(fields: [ownerId], references: [id])
  galleries       UserGallery[]

  @@map("ownership_token")
}

model UserGallery {
  id               Int             @id @default(autoincrement())
  userId           Int             @map("user_id")
  artworkId        Int             @map("artwork_id")
  ownershipTokenId Int?            @map("ownership_token_id")
  artwork          Artwork         @relation(fields: [artworkId], references: [id])
  ownershipToken   OwnershipToken? @relation(fields: [ownershipTokenId], references: [id])
  user             User            @relation(fields: [userId], references: [id])

  @@map("user_gallery")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String?
  artworks Artwork[]

  @@map("category")
}

model Collection {
  id                 Int              @id @default(autoincrement())
  artistId           Int?             @map("artist_id")
  userId             Int?             @map("user_id")
  title              String?
  description        String?
  isPrivate          Boolean          @default(false) @map("is_private")
  isDefaultFavorites Boolean          @default(false) @map("is_default_favorites")
  createdAt          DateTime?        @map("created_at")
  artist      Artist?          @relation(fields: [artistId], references: [id])
  user        User?            @relation("user_collections", fields: [userId], references: [id])
  items       CollectionItem[]

  @@map("collection")
}

model CollectionItem {
  id           Int        @id @default(autoincrement())
  collectionId Int        @map("collection_id")
  artworkId    Int        @map("artwork_id")
  artwork      Artwork    @relation(fields: [artworkId], references: [id])
  collection   Collection @relation(fields: [collectionId], references: [id])

  @@map("collection_item")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  orders    Order[]

  @@map("cart")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  artworkId Int      @map("artwork_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id])

  @@unique([cartId, artworkId])
  @@index([artworkId])
  @@map("cart_item")
}

model Order {
  id                   Int                    @id @default(autoincrement())
  publicId             String                 @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId               Int                    @map("user_id")
  cartId               Int                    @map("cart_id")
  cartVersion          Int                    @map("cart_version")
  pricingFingerprint   String                 @map("pricing_fingerprint")
  status               OrderStatus            @default(PENDING_PAYMENT)
  checkoutVersion      Int                    @default(1) @map("checkout_version")
  subtotalAmount       Int                    @map("subtotal_amount")
  taxAmount            Int                    @default(0) @map("tax_amount")
  feeAmount            Int                    @default(0) @map("fee_amount")
  commissionAmount     Int                    @default(0) @map("commission_amount")
  totalAmount          Int                    @map("total_amount")
  // Legacy display field kept during the develop-to-fiat transition only.
  totalToken           Int?                   @map("total_token")
  currency             Currency               @default(EUR)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  paidAt               DateTime?              @map("paid_at") @db.Timestamp(6)
  canceledAt           DateTime?              @map("canceled_at") @db.Timestamp(6)
  expiresAt            DateTime               @map("expires_at") @db.Timestamp(6)
  user                 User                   @relation(fields: [userId], references: [id])
  cart                 Cart                   @relation(fields: [cartId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  reservations         InventoryReservation[]
  financialTransitions FinancialTransition[]
  fulfillmentTasks     FulfillmentTask[]
  operatorAlerts       PaymentOperatorAlert[]
  refunds              Refund[]

  @@unique([cartId, cartVersion])
  @@index([userId, status])
  @@map("order")
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  artworkId        Int      @map("artwork_id")
  // Legacy display field; Stripe totals are unitAmount/subtotalAmount.
  priceTokens      String?  @map("price_tokens")
  artworkTitle     String   @map("artwork_title")
  artistName       String   @map("artist_name")
  quantity         Int      @default(1)
  unitAmount       Int      @map("unit_amount")
  subtotalAmount   Int      @map("subtotal_amount")
  commissionAmount Int      @default(0) @map("commission_amount")
  currency         Currency @default(EUR)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  artwork          Artwork  @relation(fields: [artworkId], references: [id])
  order            Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId, artworkId])
  @@map("order_item")
}

model Payment {
  id                   Int                    @id @default(autoincrement())
  orderId              Int                    @map("order_id")
  checkoutVersion      Int                    @default(1) @map("checkout_version")
  provider             PaymentProvider        @default(STRIPE)
  providerPaymentId    String?                @unique @map("provider_payment_id")
  providerStatus       String?                @map("provider_status")
  idempotencyKey       String?                @unique @map("idempotency_key")
  method               String?
  // Temporary legacy references. Stripe reconciliation uses providerPaymentId
  // and amount exclusively.
  transactionId        Int?                   @map("transaction_id")
  price                String?
  amount               Int
  refundedAmount       Int                    @default(0) @map("refunded_amount")
  currency             Currency               @default(EUR)
  status               PaymentStatus          @default(PENDING)
  failureCode          String?                @map("failure_code")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  succeededAt          DateTime?              @map("succeeded_at") @db.Timestamp(6)
  failedAt             DateTime?              @map("failed_at") @db.Timestamp(6)
  canceledAt           DateTime?              @map("canceled_at") @db.Timestamp(6)
  order                Order                  @relation(fields: [orderId], references: [id])
  webhookEvents        StripeWebhookEvent[]
  financialTransitions FinancialTransition[]
  operatorAlerts       PaymentOperatorAlert[]
  refunds              Refund[]

  @@unique([orderId, checkoutVersion])
  @@map("payment")
}

model StripeWebhookEvent {
  id             Int                @id @default(autoincrement())
  eventId        String             @unique @map("event_id")
  eventType      String             @map("event_type")
  stripeObjectId String?            @map("stripe_object_id")
  paymentId      Int?               @map("payment_id")
  refundId       Int?               @map("refund_id")
  status         WebhookEventStatus @default(PENDING)
  attemptCount   Int                @default(0) @map("attempt_count")
  lastErrorCode  String?            @map("last_error_code")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  processedAt    DateTime?          @map("processed_at") @db.Timestamp(6)
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refund         Refund?            @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([stripeObjectId, eventType])
  @@map("stripe_webhook_event")
}

model Refund {
  id                Int                  @id @default(autoincrement())
  publicId          String               @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  orderId           Int                  @map("order_id")
  paymentId         Int                  @map("payment_id")
  requestedByUserId Int                  @map("requested_by_user_id")
  providerRefundId  String?              @unique @map("provider_refund_id")
  providerStatus    String?              @map("provider_status")
  providerReference String?              @map("provider_reference")
  idempotencyKey    String               @unique @map("idempotency_key")
  amount            Int
  currency          Currency             @default(EUR)
  status            RefundStatus         @default(PENDING)
  reasonCode        String               @map("reason_code")
  failureCode       String?              @map("failure_code")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  succeededAt       DateTime?            @map("succeeded_at") @db.Timestamp(6)
  failedAt          DateTime?            @map("failed_at") @db.Timestamp(6)
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy       User                 @relation("refundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  webhookEvents     StripeWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([paymentId, status])
  @@map("refund")
}

model InventoryReservation {
  id        Int                        @id @default(autoincrement())
  orderId   Int                        @map("order_id")
  artworkId Int                        @map("artwork_id")
  quantity  Int
  status    InventoryReservationStatus @default(ACTIVE)
  expiresAt DateTime                   @map("expires_at") @db.Timestamp(6)
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  order     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artwork   Artwork                    @relation(fields: [artworkId], references: [id])

  @@unique([orderId, artworkId])
  @@index([artworkId, status, expiresAt])
  @@map("inventory_reservation")
}

model FinancialTransition {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  paymentId      Int?     @map("payment_id")
  stripeEventId  String   @map("stripe_event_id")
  stripeObjectId String   @map("stripe_object_id")
  entityType     String   @map("entity_type")
  previousStatus String   @map("previous_status")
  nextStatus     String   @map("next_status")
  reasonCode     String   @map("reason_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([stripeEventId, entityType, previousStatus, nextStatus])
  @@index([orderId, createdAt])
  @@map("financial_transition")
}

model FulfillmentTask {
  id           Int                   @id @default(autoincrement())
  orderId      Int                   @map("order_id")
  taskType     String                @map("task_type")
  taskKey      String                @unique @map("task_key")
  status       FulfillmentTaskStatus @default(PENDING)
  attemptCount Int                   @default(0) @map("attempt_count")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  processedAt  DateTime?             @map("processed_at") @db.Timestamp(6)
  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("fulfillment_task")
}

model PaymentOperatorAlert {
  id             Int       @id @default(autoincrement())
  orderId        Int       @map("order_id")
  paymentId      Int?      @map("payment_id")
  stripeEventId  String    @map("stripe_event_id")
  stripeObjectId String    @map("stripe_object_id")
  code           String
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamp(6)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment        Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([stripeEventId, code])
  @@index([status, createdAt])
  @@map("payment_operator_alert")
}

model Favorite {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  artworkId Int       @map("artwork_id")
  createdAt DateTime? @map("created_at")
  artwork   Artwork   @relation(fields: [artworkId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, artworkId])
  @@map("favorite")
}

model Follow {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  artistId  Int       @map("artist_id")
  createdAt DateTime? @map("created_at")
  artist    Artist    @relation(fields: [artistId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, artistId])
  @@map("follow")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String?   @map("token_hash")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime? @map("created_at")
  revoked   Boolean?
  user      User      @relation(fields: [userId], references: [id])

  @@map("refresh_token")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  action     String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime? @map("created_at")
  user       User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ConsentRGPD {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  consentType String?   @map("consent_type")
  accepted    Boolean?
  createdAt   DateTime? @map("created_at")
  user        User      @relation(fields: [userId], references: [id])

  @@map("consent_RGPD")
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation("emailVerificationTokens", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("email_verification_token")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  purpose   String    @default("reset")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation("passwordResetTokens", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("password_reset_token")
}

model LoginVerificationCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation("loginVerificationCodes", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("login_verification_code")
}

model RememberedDevice {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation("rememberedDevices", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("remembered_device")
}
