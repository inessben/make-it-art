POSTGRES_DB=makeitart
POSTGRES_USER=mia
POSTGRES_PASSWORD=mia_dev_password
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_APP_BASE_URL=http://localhost
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Umami analytics (self-hosted, tracker loaded only after the visitor accepts
# non-essential cookies; served first-party at /stats/script.js - see
# infrastructure/nginx/default.conf). Fill UMAMI_WEBSITE_ID after creating the
# website once in Umami's own first-run onboarding.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=umami_dev_password
UMAMI_APP_SECRET=dev_umami_secret_change_me
UMAMI_API_USERNAME=admin
UMAMI_API_PASSWORD=umami
UMAMI_WEBSITE_ID=
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@art.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_BYPASS_LOGIN_CODE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
SAVED_PAYMENT_METHOD_CONSENT_VERSION=2026-07-26
PAYMENT_METHODS_POLICY=card_only
PAYMENT_MARKET_COUNTRY=FR
PAYMENT_CUSTOMER_SCOPE=B2C
PAYMENT_MERCHANT_OF_RECORD=MAKE_IT_ART
STRIPE_TAX_ENABLED=false
FRANCE_B2C_VAT_RATE_BPS=2000
PLATFORM_COMMISSION_RATE_BPS=700
COMMISSION_INVOICING_ENABLED=false
COMMISSION_VAT_RATE_BPS=0
INVOICE_ISSUER_LEGAL_NAME=Make It Art Sandbox
INVOICE_ISSUER_ADDRESS_LINE1=Adresse de test
INVOICE_ISSUER_ADDRESS_LINE2=
INVOICE_ISSUER_POSTAL_CODE=75000
INVOICE_ISSUER_CITY=Paris
INVOICE_ISSUER_COUNTRY=FR
INVOICE_ISSUER_REGISTRATION_ID=SANDBOX
INVOICE_ISSUER_VAT_ID=FR-SANDBOX
INVOICE_ISSUER_EMAIL=billing@make-it-art.local
CHECKOUT_EXPIRATION_SWEEP_MS=60000
PAYMENT_RECONCILIATION_SWEEP_MS=300000
PAYMENT_ALERT_EMAIL=
ARTIST_WITHDRAWAL_ALERT_EMAIL=
ARTIST_WITHDRAWAL_MIN_AMOUNT=2500
FULFILLMENT_SWEEP_MS=5000
FULFILLMENT_BATCH_SIZE=20
FULFILLMENT_LEASE_MS=300000
FULFILLMENT_MAX_ATTEMPTS=5
FULFILLMENT_RETRY_BASE_MS=5000
PAYMENT_ANOMALY_SWEEP_MS=300000
PAYMENT_ANOMALY_STALE_MS=300000
PAYMENT_ALERT_COOLDOWN_SECONDS=3600
DISPUTE_RIGHTS_POLICY=SUSPEND_ON_OPEN
DISPUTE_RIGHTS_POLICY_CONFIRMED=true
CHECKOUT_ENABLED=true
CSRF_COOKIE_NAME=mia_csrf

# Artwork media pipeline (local by default; set provider to s3 or cloudinary for remote storage)
ARTWORK_STORAGE_PROVIDER=local
ARTWORK_PREVIEW_MAX_WIDTH=1600
ARTWORK_PREVIEW_QUALITY=82
ARTWORK_WATERMARK_TEXT=Make It Art
ARTWORK_WATERMARK_PUBLIC_PREVIEWS=true
ARTWORK_IMAGE_DRM_ENABLED=true
# Optional dedicated secret (falls back to JWT_SECRET)
# ARTWORK_IMAGE_DRM_SECRET=change_me_image_drm_secret
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=make-it-art

# Optional npm registry override for docker build (network issues)
# Example mirror: https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
