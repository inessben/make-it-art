POSTGRES_DB=makeitart
POSTGRES_USER=mia
POSTGRES_PASSWORD=mia_dev_password
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_APP_BASE_URL=http://localhost
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Umami analytics (self-hosted, tracker loaded only after the visitor accepts
# non-essential cookies; served first-party at /stats/script.js - see
# infrastructure/nginx/default.conf). Fill UMAMI_WEBSITE_ID after creating the
# website once in Umami's own first-run onboarding.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=umami_dev_password
UMAMI_APP_SECRET=dev_umami_secret_change_me
UMAMI_API_USERNAME=admin
UMAMI_API_PASSWORD=umami
UMAMI_WEBSITE_ID=
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@art.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_BYPASS_LOGIN_CODE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_EXPIRATION_SWEEP_MS=60000
CSRF_COOKIE_NAME=mia_csrf

# Optional npm registry override for docker build (network issues)
# Example mirror: https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
