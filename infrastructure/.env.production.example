SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_BYPASS_LOGIN_CODE=false
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://www.makeitart.io/api/auth/google/callback

STRIPE_SECRET_KEY=replace_with_stripe_live_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_distinct_live_endpoint_secret
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=replace_with_reviewed_card_only_pmc_id
PAYMENT_METHODS_POLICY=card_only
PAYMENT_MARKET_COUNTRY=FR
PAYMENT_CUSTOMER_SCOPE=B2C
PAYMENT_MERCHANT_OF_RECORD=MAKE_IT_ART
STRIPE_TAX_ENABLED=false
# Valeur d'exemple uniquement : faire confirmer le taux par le responsable fiscal.
FRANCE_B2C_VAT_RATE_BPS=2000
PLATFORM_COMMISSION_RATE_BPS=700
COMMISSION_INVOICING_ENABLED=false
COMMISSION_VAT_RATE_BPS=0
INVOICE_ISSUER_LEGAL_NAME=replace_with_legal_entity_name
INVOICE_ISSUER_ADDRESS_LINE1=replace_with_legal_address
INVOICE_ISSUER_ADDRESS_LINE2=
INVOICE_ISSUER_POSTAL_CODE=replace_with_postal_code
INVOICE_ISSUER_CITY=replace_with_city
INVOICE_ISSUER_COUNTRY=FR
INVOICE_ISSUER_REGISTRATION_ID=replace_with_siren_or_siret
INVOICE_ISSUER_VAT_ID=replace_with_french_vat_id
INVOICE_ISSUER_EMAIL=facturation@makeitart.io
CHECKOUT_EXPIRATION_SWEEP_MS=60000
PAYMENT_RECONCILIATION_SWEEP_MS=300000
PAYMENT_ALERT_EMAIL=payments-alerts@makeitart.io
FULFILLMENT_SWEEP_MS=5000
FULFILLMENT_BATCH_SIZE=20
FULFILLMENT_LEASE_MS=300000
FULFILLMENT_MAX_ATTEMPTS=5
FULFILLMENT_RETRY_BASE_MS=5000
PAYMENT_ANOMALY_SWEEP_MS=300000
PAYMENT_ANOMALY_STALE_MS=300000
PAYMENT_ALERT_COOLDOWN_SECONDS=3600
DISPUTE_RIGHTS_POLICY=SUSPEND_ON_OPEN
DISPUTE_RIGHTS_POLICY_CONFIRMED=true
CHECKOUT_ENABLED=false
STRIPE_WEBHOOK_EVENTS=payment_intent.processing,payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled,refund.created,refund.updated,refund.failed,charge.dispute.created,charge.dispute.updated,charge.dispute.closed
# Conserver ces validations à false jusqu'aux revues humaines et au smoke test live.
PAYMENT_ROTATION_RUNBOOK_ACK=false
PAYMENT_CSP_REVIEW_ACK=false
PAYMENT_ALERT_TEST_ACK=false
PAYMENT_FISCAL_POLICY_ACK=false
PAYMENT_ARCHITECTURE_DECISION_ACK=false
PAYMENT_METHODS_POLICY_ACK=false
PAYMENT_LIVE_SMOKE_TEST_APPROVED=false

SMTP_HOST=smtp.your-provider.tld
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Make It Art <no-reply@makeitart.io>

# Umami analytics (self-hosted, internal-only - see infrastructure/Caddyfile)
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change_this_umami_database_password
UMAMI_APP_SECRET=change_this_to_a_long_random_secret
# Create this user once via Umami's first-run onboarding (never expose it publicly).
UMAMI_API_USERNAME=change_this_admin_username
UMAMI_API_PASSWORD=change_this_admin_password
# Copy from Umami's website settings after creating the makeitart.io website there.
UMAMI_WEBSITE_ID=

NPM_REGISTRY=https://registry.npmjs.org
