{
  "name": "@make-it-art/frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#app-manifest": "./nuxt-internal/app-manifest.mjs",
    "#internal/nuxt/paths": "./nuxt-internal/paths.mjs"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0 --port 3000",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "security:audit": "npm audit --workspaces=false --omit=dev --omit=optional --audit-level=high",
    "lint": "eslint . --ext .js,.vue,.ts --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.vue,.ts --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --config .prettierrc.json . --write",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --config .prettierrc.json . --check",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@coinbase/cdp-core": "^0.0.119",
    "@pinia/nuxt": "^0.11.3",
    "@stripe/stripe-js": "^9.10.0",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "nuxt": "4.5.0",
    "pinia": "^3.0.4"
  },
  "overrides": {
    "immutable": "5.1.9",
    "archiver": {
      "readdir-glob": "3.0.0"
    },
    "archiver-utils": {
      "glob": "^13.0.0"
    }
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.2.9"
  }
}
